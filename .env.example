# Local-only Postgres (docker-compose.yml). Copy to .env and adjust if needed.
# Never put real credentials in this file or in .env if it's ever committed —
# .env is gitignored; this .env.example must only ever contain placeholders.
POSTGRES_DB=acplatform
POSTGRES_USER=acplatform
POSTGRES_PASSWORD=acplatform_local_only
POSTGRES_PORT=5432
