# Backend-specific local environment variables. Copy to backend/.env (gitignored) and
# adjust if needed. NEVER put real credentials in this file or in backend/.env if it is
# ever committed — this file must only ever contain placeholders (constitution rule 16).
#
# These map onto Spring Boot's standard datasource environment variables, read in
# backend/app/src/main/resources/application.yml. Defaults there already match
# docker-compose.yml / the repo-root .env.example for one-command local startup, so
# none of these are required for local dev — set them only to override.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/acplatform
SPRING_DATASOURCE_USERNAME=acplatform
SPRING_DATASOURCE_PASSWORD=acplatform_local_only

# Spring profile(s) to activate. Include "local" for permissive dev CORS
# (com.acplatform.app.config.LocalDevCorsConfig) — NEVER include "local" or "dev"
# outside a developer's own machine.
SPRING_PROFILES_ACTIVE=local
