# Copy to .env.local (or .env) for local development. Never commit real
# secrets here — this file is checked in and must only ever contain
# placeholder-safe values (constitution rule 16). There are currently no
# secrets in the web client: no API keys or tokens are configured client
# side; auth tokens, once identity-access ships, are attached in-memory by
# src/api/client.ts, never read from an env var.

# Backend base URL, including the version segment. Local dev backend runs
# on port 8080 (see ../docker-compose.yml / ../backend).
VITE_API_BASE_URL=http://localhost:8080/v1
