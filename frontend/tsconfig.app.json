{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strict mode (constitution/ADR-005 requirement) */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // NOTE: left off deliberately (deviation from the create-vite default).
    // The shared workspace packages this app must consume as-is
    // (@acplatform/api-contracts's ApiError, e.g.) use constructor
    // parameter properties, an idiomatic TS pattern with real (but fully
    // erasable-by-a-real-transpiler) runtime semantics. This app is built
    // by Vite/esbuild, a real bundler that already handles that syntax
    // correctly — "erasableSyntaxOnly" targets type-stripping-only
    // pipelines (e.g. Node's native TS support), which this project is
    // not, and enabling it would make it impossible to typecheck against
    // packages/* without modifying code we don't own.
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
